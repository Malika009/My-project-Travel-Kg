PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@travelkg.kg
# Optional: set a MongoDB connection string to use MongoDB instead of server/data/store.json
MONGODB_URI=
# Optional SMTP email confirmation
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: sign in with Google / GitHub.
# Register these return addresses with the provider (production and local):
#   https://travelkg.uk/auth/oauth/google   http://localhost:5173/auth/oauth/google
#   https://travelkg.uk/auth/oauth/github   (GitHub allows one address per app; create a second app for localhost)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Site address used for the return link when the request has no Origin header
OAUTH_REDIRECT_BASE=

# Optional AI / email sending provider
AI_API_KEY=
