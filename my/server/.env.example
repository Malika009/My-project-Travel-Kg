PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@travelkg.kg
# Optional: set a MongoDB connection string to use MongoDB instead of server/data/store.json
MONGODB_URI=
# Optional SMTP email confirmation
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional OAuth providers
# Google callback URL: http://localhost:5173/auth/oauth/google
# GitHub callback URL: http://localhost:5173/auth/oauth/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional AI / email sending provider
AI_API_KEY=
